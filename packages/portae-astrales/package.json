{
  "name": "@aetherisnova/portae-astrales",
  "version": "1.1.0-beta.1",
  "private": true,
  "description": "The Portae Astrales schema allows the construction of a great Porta of Aetheris Nova facilitating the safe traversal of the Aether.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aetheris-nova/structura-contractus"
  },
  "license": "CC0-1.0",
  "type": "module",
  "main": "dist/client/index.js",
  "scripts": {
    "build": "pnpm build:contracts && pnpm build:client",
    "build:client": "pnpm run clean:client && vite build",
    "build:contracts": "pnpm clean:contracts && mud build",
    "build:dependencies": "exit 0",
    "clean": "shx rm -rf dist/client && shx rm -rf tsconfig.*.tsbuildinfo",
    "clean:client": "shx rm -rf dist/client && shx rm -rf tsconfig.*.tsbuildinfo",
    "clean:contracts": "forge clean && shx rm -rf dist/contracts .mud/codegen",
    "deploy": "./scripts/deploy.sh",
    "lint": "concurrently --names \"CLIENT,CONTRACTS\" -c \"yellow.bold,magenta.bold\" \"pnpm lint:client\" \"pnpm lint:contracts\"",
    "lint:client": "eslint .",
    "lint:contracts": "solhint --config .solhint.json \"src/**/*.sol\"",
    "postinstall": "./scripts/postinstall.sh",
    "prettier": "prettier --write \"**/*.{js,json,sol,ts}\"",
    "start:client": "vite dev",
    "test": "pnpm test:contracts && pnpm test:client",
    "test:client": "exit 0",
    "test:contracts": "shx cp .env.test .env && pnpm run deploy && forge test --fork-url http://127.0.0.1:8545 -vv"
  },
  "dependencies": {
    "@aetherisnova/errors": "catalog:",
    "@aetherisnova/types": "catalog:",
    "@aetherisnova/ui-components": "catalog:",
    "@aetherisnova/utils": "catalog:",
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@eveworld/common-constants": "catalog:",
    "@eveworld/contracts": "catalog:",
    "@eveworld/types": "catalog:",
    "@eveworld/utils": "catalog:",
    "@eveworld/world": "catalog:",
    "@latticexyz/cli": "catalog:",
    "@latticexyz/explorer": "catalog:",
    "@latticexyz/schema-type": "catalog:",
    "@latticexyz/store": "catalog:",
    "@latticexyz/store-indexer": "catalog:",
    "@latticexyz/world": "catalog:",
    "@latticexyz/world-modules": "catalog:",
    "@stablelib/random": "^2.0.1",
    "@stablelib/uuid": "^2.0.1",
    "@tanstack/react-query": "^5.63.0",
    "@wagmi/core": "^2.16.3",
    "axios": "^1.7.9",
    "bignumber.js": "^9.1.2",
    "i18next": "^24.2.1",
    "next-themes": "^0.4.4",
    "numbro": "^2.5.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-helmet": "^6.1.0",
    "react-i18next": "^15.4.0",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.1.1",
    "viem": "2.x",
    "wagmi": "^2.14.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@chakra-ui/color-mode": "^2.2.0",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-helmet": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "chalk": "catalog:",
    "concurrently": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "solhint": "catalog:",
    "shx": "catalog:",
    "solhint-config-mud": "catalog:",
    "solhint-plugin-mud": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:"
  }
}
